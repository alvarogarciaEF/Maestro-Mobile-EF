APP_ID_ANDROID=com.enviaflores.android
APP_ID_IOS=com.enviaflores.ios
USER_EMAIL=qa.user@example.com
USER_PASSWORD=change-me
GOOGLE_ACCOUNT_EMAIL=qa.user@example.com
# Debe ser una cuenta Google REAL agregada al emulador (Gmail/Workspace).
# No uses Mailinator aqui; reservalo para USER_EMAIL si aplica.
USER_DISPLAY_NAME="Prueba!"
DEFAULT_STATE="Nuevo León"
DEFAULT_CITY=Monterrey
ADDRESS_RECIPIENT_NAME="QA Maestro"
ADDRESS_PHONE=8112345678
ADDRESS_STREET="Padre Mier"
ADDRESS_NUMBER=100
ADDRESS_NEIGHBORHOOD=Centro
ADDRESS_ZIP=64000
ADDRESS_REFERENCES="Direccion automatizada QA Maestro"
PRODUCT_SEARCH_TERM=rosas
PRODUCT_NAME="Clásico Amor con 24 Rosas Rojas"
SECOND_PRODUCT_SEARCH_TERM=globo
SECOND_PRODUCT_NAME="Globo Esfera Magenta con Rosas"
SEARCH_NO_RESULTS_TERM=zzzqa-sin-resultados-999
PRODUCT_UNAVAILABLE_SEARCH_TERM=rosas
PRODUCT_UNAVAILABLE_NAME="SKU no disponible QA"
USER_INVALID_PASSWORD=wrong-password-qa
RECOVERY_UNKNOWN_EMAIL=no-existe-qa@enviaflores.com
INVALID_COUPON_CODE=QA-CUPON-INVALIDO
# Cupones QA en carrito (ALE / MOACYR15, ambos 15% OFF). Omitir VALID_COUPON_CODE = aleatorio por corrida.
# VALID_COUPON_CODE=ALE
COUPON_DISCOUNT_PERCENT=15
# Tarjeta sandbox que debe fallar al tokenizar/pagar (ajustar segun gateway QA)
SANDBOX_DECLINE_CARD_NUMBER=4000000000000002
SANDBOX_DECLINE_CARD_EXPIRY=1230
SANDBOX_DECLINE_CARD_FIRST_NAME=QA
SANDBOX_DECLINE_CARD_LAST_NAME=Decline
CATEGORY_NAME="Cumpleaños"
HOME_CATEGORY_BIRTHDAY="Cumpleaños"
HOME_CATEGORY_FLOWERS="Flores y plantas"
HOME_CATEGORY_GIFTS=Regalos
ALTERNATE_STATE=Jalisco
ALTERNATE_CITY=Guadalajara
REMINDER_TITLE="QA Recordatorio Maestro"
DEEPLINK_HOME=enviaflores://
# Deeplinks HTTPS (ajustar SKU/slug segun catalogo QA)
DEEPLINK_CATEGORY=https://www.enviaflores.com/florerias-nuevo-leon/monterrey/cumpleanos
DEEPLINK_PRODUCT=https://www.enviaflores.com/florerias-nuevo-leon/monterrey/001
DEEPLINK_PERSONALIZED_PRODUCT=https://www.enviaflores.com/florerias-nuevo-leon/monterrey/26009
# Opcional: titulo esperado en PDP personalizable (regex Maestro no soportado; usar assert parcial en flow)
# PERSONALIZED_PRODUCT_NAME=Personaliza
# Rango de precio para price-range-filter.yaml (texto del API, alineado con web PRICE_RANGES)
PRICE_FILTER_RANGE="Menor $399"
PRICE_FILTER_RANGE_HIGH="Mayor $990"
SORT_ORDER_DESC="Mayor a menor $"
CITY_CHANGE_CART_BEHAVIOR=either
SEARCH_AUTOCOMPLETE_TERM=globo
DEEPLINK_CART=https://www.enviaflores.com/shoppingcart
DEEPLINK_FAQ=https://www.enviaflores.com/faq
BIN_NUMBER=55462590
BIN_CARD_NUMBER=5546259000000000
BIN_CARD_FIRST_NAME=Alvaro
BIN_CARD_LAST_NAME=Garcia
BIN_CARD_EXPIRY=1230
# Para batch de BINes: 0 evita limpiar estado por cada BIN; 1 limpia una vez al inicio.
BIN_CLEAR_STATE=0
# URL del servicio binlookup. Usa {bin} para inyectar el BIN bajo prueba.
BINLOOKUP_URL=https://ef-storefront-web-qa.enviaflores.com/api/payments/bin-lookup?bin={bin}
